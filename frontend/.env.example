# Copy this file to .env and fill in real values locally. Also add the same
# keys in the Vercel dashboard (Project Settings → Environment Variables).
# Never commit the real .env file — it's gitignored.

# Optional: full API origin if /api is not on this host (e.g. https://kavicode.vercel.app)
VITE_API_URL=

# MongoDB Atlas connection string
MONGODB_URI=

# Single-admin login (server-only — never prefix with VITE_/NEXT_PUBLIC_)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Required for image/video uploads (Vercel Blob → Storage → Blob → .env.local tab)
BLOB_READ_WRITE_TOKEN=
